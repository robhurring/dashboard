#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Tools installed with `cargo install` live here; Homebrew's cargo does not put it on PATH.
export PATH="$HOME/.cargo/bin:$PATH"

usage() {
  echo "usage: bin/dev [-o|--open]    run Redis, the Rust server (port 4000) and Vite (port 5173) with live reload and both logs"
  echo "  -o, --open    open the dashboard in a browser once it's up"
}
open_browser=false
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    -o|--open) open_browser=true ;;
    *) usage >&2; exit 2 ;;
  esac
done

# Redis: skip Docker when something already answers on the dev port (and so a wedged Docker Desktop
# can't hang startup); otherwise start the compose service, giving up after a minute.
if nc -z -w 2 127.0.0.1 6380 2>/dev/null; then
  echo "redis: already up on 6380"
elif ! $(command -v timeout >/dev/null && echo "timeout 60") docker compose up -d redis; then
  echo "bin/dev: couldn't start Redis with Docker (is Docker Desktop running and responsive?)" >&2
  exit 1
fi
[[ -f .env ]] || cp .env.example .env
# The repo's .env wins over anything already exported in your shell (a key in ~/.zshrc, say): load it
# here, before the process runner, which would otherwise only fill in what the shell hasn't set.
set -a; . ./.env; set +a

# Procfile runners start commands through the login shell, whose init can reorder PATH and pick a
# different node. Pin the one this shell resolves so the web process uses it too.
export DASHBOARD_NODE_DIR="$(dirname "$(command -v node)")"

# --open: wait (in the background, up to two minutes) for Vite to answer, then open it.
if $open_browser; then
  (
    url="http://localhost:5173"
    for _ in $(seq 1 120); do
      if curl -s -o /dev/null "$url"; then
        if command -v open >/dev/null; then open "$url"; elif command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1; fi
        exit 0
      fi
      sleep 1
    done
  ) &
fi

# Procfile.dev runs both processes with prefixed, interleaved logs. foreman/overmind read .env themselves.
# `command -v` is not enough: rbenv shims exist even when the gem is missing from the active Ruby.
if overmind --version >/dev/null 2>&1; then
  exec overmind start -f Procfile.dev
elif ultraman --version >/dev/null 2>&1; then      # cargo install ultraman
  exec ultraman start -f Procfile.dev -e .env
elif foreman version >/dev/null 2>&1; then
  exec foreman start -f Procfile.dev -e .env
fi

# Fallback without a Procfile runner: same processes, prefixed by hand. bash 3.2 compatible.
set -a; . ./.env; set +a
export PORT="${PORT:-4000}" REDIS_URL="${REDIS_URL:-redis://127.0.0.1:6380}" REDIS_PREFIX="${REDIS_PREFIX:-dev:}"
# Everything started here shares this script's process group, so one signal to the group stops it all.
cleanup() { trap - EXIT INT TERM; kill 0 2>/dev/null; wait 2>/dev/null || true; }
trap cleanup EXIT INT TERM
bin/dev-server 2>&1 | sed -u 's/^/[server] /' &
(cd web && npm run dev -- --clearScreen false 2>&1 | sed -u 's/^/[web]    /') &
echo "dashboard: http://localhost:5173"
wait
