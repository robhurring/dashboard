#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# DASHBOARD_HOST (and optional DASHBOARD_IP) come from the environment or .env; see .env.example.
if [[ -f .env ]]; then
  for var in DASHBOARD_HOST DASHBOARD_IP PI_HOST; do
    [[ -n "${!var:-}" ]] || eval "$(grep -E "^$var=" .env | tail -1 | sed 's/^/export /')"
  done
fi
PI_HOST="${PI_HOST:-}"
PI_DIR="${PI_DIR:-dashboard-pi}"
usage() {
  cat <<USAGE
usage: bin/pi <command>    manage the kiosk Pi over ssh (PI_HOST=$PI_HOST)
  setup     copy pi/ to the Pi and run its idempotent setup.sh
  push      copy the kiosk config files to their live paths
  pull      copy the live kiosk config files back into pi/
  restart   relaunch the kiosk browser without rebooting
USAGE
}

if [[ -z "$PI_HOST" && "${1:-}" != "" && "${1:-}" != "-h" && "${1:-}" != "--help" ]]; then
  echo "set PI_HOST (in .env or the environment) to the Pi's ssh host, e.g. PI_HOST=admin@dashboard-kiosk.local" >&2
  exit 1
fi
case "${1:-}" in
  setup)
    ssh "$PI_HOST" "mkdir -p ~/$PI_DIR"
    scp -q pi/* "$PI_HOST:~/$PI_DIR/"
    : "${DASHBOARD_HOST:?set DASHBOARD_HOST in .env (the hostname the kiosk opens)}"
    ssh "$PI_HOST" "DASHBOARD_HOST=$(printf %q "$DASHBOARD_HOST") DASHBOARD_IP=$(printf %q "${DASHBOARD_IP:-}") bash ~/$PI_DIR/setup.sh" ;;
  push)
    scp -q pi/kiosk.sh      "$PI_HOST:~/kiosk.sh"
    scp -q pi/kiosk.desktop "$PI_HOST:~/.config/autostart/kiosk.desktop"
    scp -q pi/kanshi.config "$PI_HOST:~/.config/kanshi/config"
    scp -q pi/labwc-rc.xml  "$PI_HOST:~/.config/labwc/rc.xml"
    ssh "$PI_HOST" 'chmod +x ~/kiosk.sh'
    if [[ -n "${DASHBOARD_HOST:-}" ]]; then
      ssh "$PI_HOST" "mkdir -p ~/.config && echo DASHBOARD_URL=http://$(printf %q "$DASHBOARD_HOST") > ~/.config/dashboard-kiosk.env"
    fi
    echo "pushed. run 'bin/pi restart' to relaunch the browser." ;;
  pull)
    scp -q "$PI_HOST:~/kiosk.sh"                        pi/kiosk.sh
    scp -q "$PI_HOST:~/.config/autostart/kiosk.desktop" pi/kiosk.desktop
    scp -q "$PI_HOST:~/.config/kanshi/config"           pi/kanshi.config
    scp -q "$PI_HOST:~/.config/labwc/rc.xml"            pi/labwc-rc.xml ;;
  restart)
    # The [c] keeps pkill from matching this ssh command line.
    ssh "$PI_HOST" 'pkill -f "[c]hromium.*--kiosk" || true; sleep 1; WAYLAND_DISPLAY=$(ls /run/user/$(id -u) | grep -m1 "^wayland-[0-9]*$") XDG_RUNTIME_DIR=/run/user/$(id -u) DISPLAY=:0 setsid -f ~/kiosk.sh >/dev/null 2>&1 </dev/null'
    echo "kiosk relaunched." ;;
  -h|--help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
