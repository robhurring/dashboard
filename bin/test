#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() { echo "usage: bin/test    run Rust and frontend tests; fails if generated protocol types drift"; }
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) usage >&2; exit 1 ;;
esac

export TEST_REDIS_URL="${TEST_REDIS_URL:-redis://127.0.0.1:6380}"
cargo test --workspace
if [[ -d web/src/protocol ]] && ! git diff --quiet -- web/src/protocol web/src/serde_json; then
  echo "generated protocol types changed; commit web/src/protocol and web/src/serde_json" >&2
  exit 1
fi
(cd web && npx vitest run)
