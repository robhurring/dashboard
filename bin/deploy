#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  cat <<USAGE
usage: bin/deploy [staging|prod]    deploy the current commit to Dokku (default: staging)

Private extensions ship too, without ever entering this repo's history: the commit pushed to Dokku is
built off to the side from HEAD plus every extension folder (MODULES_DIR, THEMES_DIR, WIDGETS_DIR beyond
the repo's own, and local/), gathered into local/. Only Dokku sees that commit.

DEPLOY_DRY_RUN=1 builds that commit and lists what it would ship, without pushing.
USAGE
}
target="${1:-staging}"
case "$target" in
  -h|--help) usage; exit 0 ;;
  staging) remote="${DOKKU_STAGING_REMOTE:-dokku-next}" ;;
  prod)
    remote="${DOKKU_PROD_REMOTE:-dokku}"
    read -r -p "Deploy $(git branch --show-current) to PRODUCTION ($remote)? Type 'prod' to continue: " answer
    [[ "$answer" == "prod" ]] || { echo "cancelled"; exit 1; } ;;
  *) usage >&2; exit 1 ;;
esac

git diff --quiet && git diff --cached --quiet || { echo "commit or stash your changes first" >&2; exit 1; }
url=$(git remote get-url "$remote" 2>/dev/null) || { echo "git remote '$remote' is missing; see docs/deploy/dokku.md" >&2; exit 1; }

# Folder lists from the environment or .env, with the same defaults the server and the web build use.
setting() { local v="${!1:-}"; [[ -n "$v" ]] || v=$(grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true); echo "${v:-$2}"; }
modules_dirs=$(setting MODULES_DIR "local/modules:modules")
themes_dirs=$(setting THEMES_DIR "local/themes:web/themes")
widgets_dirs=$(setting WIDGETS_DIR "local/widgets")
application=$(setting APPLICATION_FILE "")

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
git archive HEAD | tar -x -C "$stage"
mkdir -p "$stage/local/modules" "$stage/local/themes" "$stage/local/widgets"

# Copies the listed folders into local/<kind>, searched like $PATH: the first folder with a name wins.
# The repo's own folder ships in the image anyway; it's only consulted so a name it holds shadows the folders after it.
gather() {
  local list=$1 repo_dir=$2 kind=$3 dir entry name
  local -a seen=()
  IFS=':' read -r -a dirs <<<"$list"
  for dir in "${dirs[@]}"; do
    dir="${dir// /}"
    [[ -z "$dir" || ! -d "$dir" ]] && continue
    for entry in "$dir"/*; do
      [[ -e "$entry" ]] || continue
      name=$(basename "$entry")
      [[ " ${seen[*]-} " == *" $name "* ]] && continue
      seen+=("$name")
      [[ "$dir" == "$repo_dir" ]] && continue
      cp -R "$entry" "$stage/local/$kind/"
      echo "  + $kind/$name  (from $dir)"
    done
  done
}
echo "extensions:"
gather "$modules_dirs" modules modules
gather "$themes_dirs" web/themes themes
gather "$widgets_dirs" "" widgets
if [[ -n "$application" && "$application" != "application.lua" ]]; then
  cp "$application" "$stage/local/application.lua"; echo "  + application.lua  (from $application)"
elif [[ -f local/application.lua ]]; then
  cp local/application.lua "$stage/local/application.lua"; echo "  + application.lua  (from local/)"
fi
find "$stage/local" -name .git -prune -exec rm -rf {} +

rev=$(git rev-parse --short HEAD)
(
  cd "$stage"
  git init -q
  git add -A
  git add -f local   # the repo ignores local/; this commit is the one place it belongs
  git -c user.name="bin/deploy" -c user.email="deploy@localhost" commit -q -m "deploy $rev with extensions"
  if [[ -n "${DEPLOY_DRY_RUN:-}" ]]; then
    echo "dry run: would push $(git rev-parse --short HEAD) to $url; files under local/:"
    git ls-files local | sed 's/^/  /'
  else
    git push --force "$url" HEAD:master
  fi
)
