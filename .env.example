# Copy to .env for local development. bin/dev loads it.
PORT=4000
# IANA zone that cron schedules run in (default UTC)
TZ=America/New_York
REDIS_URL=redis://127.0.0.1:6380
REDIS_PREFIX=dev:
RUST_LOG=info,dashboard=debug
# Module secrets
OPENWEATHERMAP_API_KEY=
FINNHUB_API_KEY=
# lib/openrouter.lua: models from Anthropic, OpenAI, Google and others, for modules that use it
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-2603
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Calendar feeds, one variable per name: <Slot module="calendar" feeds="home" /> reads CALENDAR_HOME.
# Each holds one or more iCalendar (ICS) URLs, comma-separated.
CALENDAR_HOME=
# CALENDAR_WORK=
# Shared token for inbound webhooks: callers send "Authorization: Bearer <token>". Leave unset locally and
# hooks are open; set it on hosted servers. Generate with: uuidgen
# HOOKS_TOKEN=

# Kiosk Pi (bin/pi setup): the hostname the kiosk opens, and optionally a LAN IP to pin it to in /etc/hosts
# DASHBOARD_HOST=dashboard.example.com
# DASHBOARD_IP=192.168.1.10
# PI_HOST=admin@dashboard-kiosk.local
# Display power on the Pi (see docs/pi.md). Two states, each during cron ranges (";" between several):
# dim the backlight after some idle minutes, or turn the panel off until a touch. Sleep wins where both match.
# KIOSK_DIM_WHEN="* 8-18 * * 1-5"
# KIOSK_DIM_AFTER=10
# KIOSK_DIM_LEVEL=15
# KIOSK_SLEEP_WHEN="* 0-7,19-23 * * 1-5; * * * * 0,6"
# KIOSK_SLEEP_AFTER=5

# Extensions (see docs/extending.md). Folder lists are colon-separated and searched like $PATH: first match wins.
# MODULES_DIR=local/modules:modules
# THEMES_DIR=local/themes:web/themes
# WIDGETS_DIR=local/widgets
# DEFAULT_THEME=home
# A private repo of your own modules, themes and widgets; bin/setup clones it into local/.
# LOCAL_REPO=git@github.com:you/dashboard-local.git
