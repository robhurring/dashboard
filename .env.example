# Copy to .env for local development. bin/dev loads it.
PORT=4000
# IANA zone that cron schedules run in (default UTC)
TZ=America/New_York
REDIS_URL=redis://127.0.0.1:6380
REDIS_PREFIX=dev:
RUST_LOG=info,dashboard=debug
# Module secrets
OPENWEATHERMAP_API_KEY=
FINNHUB_API_KEY=
TODOIST_API_TOKEN=
# n8n webhooks: a markdown summary per topic (?q=&n=) and the AI headlines feed
NEWS_SUMMARY_URL=
NEWS_WEBHOOK_URL=
# One or more iCalendar (ICS) feed URLs, comma-separated
GOOGLE_CALENDAR_ICS_URL=
# Shared token for inbound webhooks: callers send "Authorization: Bearer <token>". Leave unset locally and
# hooks are open; set it on hosted servers. Generate with: uuidgen
# HOOKS_TOKEN=

# Kiosk Pi (bin/pi setup): the hostname the kiosk opens, and optionally a LAN IP to pin it to in /etc/hosts
# DASHBOARD_HOST=dashboard.example.com
# DASHBOARD_IP=192.168.1.10
# PI_HOST=kiosk
